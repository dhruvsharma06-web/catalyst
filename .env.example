# Hearth environment template: variable names and descriptions only.
# Leave values blank here and fill them in a local .env file or in your deployment platform.
# The server reads process.env only; load a file with `node --env-file=.env` or your shell.
# In Cloud Run, SESSION_SECRET and JOB_TOKEN come from Secret Manager.

# --- Core ---
# development | production | test (default: development)
NODE_ENV=
# HTTP port (default: 8080)
PORT=
# Public app URL, used for links in reminder emails (default: http://localhost:5173)
APP_URL=
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=

# --- Secrets ---
# Session cookie signing key, at least 32 characters. Required when NODE_ENV=production.
SESSION_SECRET=
# Token for POST /api/v1/jobs/reminders, sent as X-Job-Token. At least 24 characters. Required in production.
JOB_TOKEN=

# --- Storage ---
# memory | firestore (default: memory)
STORE=
# Google Cloud project ID, used by Firestore and Vertex AI
GOOGLE_CLOUD_PROJECT=
# Firestore database ID (default: (default))
FIRESTORE_DATABASE_ID=

# --- AI (Gemini) ---
# true returns deterministic local output instead of calling Gemini
USE_MOCK_AI=
# Gemini Developer API key (not used when GOOGLE_GENAI_USE_VERTEXAI=true)
GEMINI_API_KEY=
# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=
# true calls Gemini through Vertex AI using the service identity
GOOGLE_GENAI_USE_VERTEXAI=
# Vertex AI region (default: asia-south1)
GOOGLE_CLOUD_LOCATION=
# Maximum AI requests per hour (default: 20)
AI_HOURLY_LIMIT=

# --- Email ---
# SMTP host. When unset, reminder emails are written to the log instead of sent.
SMTP_HOST=
# SMTP port (default: 465)
SMTP_PORT=
SMTP_USER=
# SMTP password or app password
SMTP_PASS=
# From header for reminder emails (default: Hearth Reminders <reminders@hearth.local>)
MAIL_FROM=

# --- Static web build ---
# Path to the built web app (default: web/dist resolved relative to server/dist)
WEB_DIST=

# --- Web app (Vite, read at build time) ---
# true makes the web app use fixture data instead of calling the API
VITE_USE_MOCK=

# --- Serverless hosts outside Google Cloud (e.g. Vercel) ---
# Service-account key JSON for Firestore (Google Cloud uses its own credentials instead).
GOOGLE_CREDENTIALS_JSON=
# Vercel Cron sends this as "Authorization: Bearer"; set it to the same value as JOB_TOKEN.
CRON_SECRET=
